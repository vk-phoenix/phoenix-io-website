---
import '@fontsource/geist/300.css';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  page: string;
}
const { title, description, page } = Astro.props;
const fullTitle = title ? `${title} · Phoenix I/O` : 'Phoenix I/O · Software, data and AI engineering';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['capabilities', 'Capabilities'],
  ['projects', 'Projects'],
  ['past-performance', 'Past Performance'],
  ['contracting', 'Contracting'],
  ['teaming', 'Teaming'],
  ['about', 'About'],
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#07081A">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Phoenix I/O">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/icon-512.png', Astro.site)}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Phoenix I/O LLC',
    url: 'https://phoenixio.co',
    logo: 'https://phoenixio.co/icon-512.png',
    email: 'info@phoenixio.co',
    telephone: '+1-551-465-4595',
    address: { '@type': 'PostalAddress', streetAddress: '335 George St, STE 126', addressLocality: 'New Brunswick', addressRegion: 'NJ', postalCode: '08901', addressCountry: 'US' },
  })} />
  <slot name="head" />
  <script is:inline src="/site.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>

<header class="site">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Phoenix I/O home"><img src="/brand/logo-text.png" alt="Phoenix I/O" width="1200" height="132"><img class="ember" src="/brand/logo-mark.png" alt="" aria-hidden="true" width="134" height="132"></a>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mainnav">Menu</button>
    <nav class="main" id="mainnav" aria-label="Main">
      <ul>
        {nav.map(([id, label]) => <li><a href={`/${id}/`} aria-current={page === id ? 'page' : undefined}>{label}</a></li>)}
        <li><a class="cta" href="/contact/" aria-current={page === 'contact' ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1">
<slot />
</main>

<footer class="site">
  <div class="wrap top">
    <div style="display:flex;flex-direction:column;gap:24px">
      <img src="/brand/logo-wordmark-white.png" alt="Phoenix I/O" width="1200" height="132" style="height:18px;width:auto;max-width:180px;align-self:flex-start;object-fit:contain">
      <dl class="fdata" aria-label="Company identifiers">
        <dt>UEI</dt><dd>G2VAY6MY6515</dd><dt>CAGE</dt><dd>Pending</dd><dt>Size</dt><dd>Small Business</dd><dt>NAICS</dt><dd>541511 (primary), 541512, 518210, 541519, 541611</dd>
      </dl>
    </div>
    <div><h2>Site</h2><ul>{nav.map(([id, label]) => <li><a href={`/${id}/`}>{label}</a></li>)}</ul></div>
    <div><h2>Contact</h2><ul><li>335 George St, STE 126<br>New Brunswick, NJ 08901</li><li class="mono">+1 551-465-4595</li><li class="mono">info@phoenixio.co</li><li><a href="/accessibility/">Accessibility</a> · <a href="/privacy/">Privacy</a></li></ul></div>
  </div>
  <div class="wrap bottom"><span>© {year} Phoenix I/O LLC</span><span>Company data current as of October 2026</span></div>
</footer>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>
