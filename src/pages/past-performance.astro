---
import Base from '../layouts/Base.astro';
---
<Base title={'Past Performance'} description={"Engagements led by Phoenix I/O's principals at prior firms, across logistics, healthcare, compliance, e-commerce and web services."} page="past-performance">
<section class="page" id="p-past-performance" data-title="Past Performance">
  <div class="pagehead"><div class="wrap"><span class="label">Past Performance</span><h1>Twenty years of delivery, each.</h1><p class="lede">These engagements were led by Phoenix I/O's principals at prior firms. Client names are withheld. For work delivered by Phoenix I/O, see <a href="/projects/">Projects</a>.</p></div></div>
  <section class="section">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter by capability">
        <button aria-pressed="true" data-f="all">All</button><button aria-pressed="false" data-f="data">Data platforms</button><button aria-pressed="false" data-f="apps">Applications</button><button aria-pressed="false" data-f="ai">AI automation</button><button aria-pressed="false" data-f="reg">Regulated data</button>
      </div>
      <div class="worklist" id="pplist">
        <div class="work" data-c="data"><span class="k">Logistics · Gov services</span><div><h3>Global logistics and government-services contractor</h3><p class="s">Snowflake data lake on AWS and a Data Vault warehouse; Power BI reporting servers for government services.</p></div><span class="r">$200K+/yr saved · 1,000+ reports</span><span class="go"></span></div>
        <div class="work" data-c="data"><span class="k">Construction · F500</span><div><h3>Fortune 500 homebuilder</h3><p class="s">Enterprise data fabric with a 50-person team; three legacy warehouses migrated.</p></div><span class="r">$2M+ saved · 50+ APIs to GraphQL</span><span class="go"></span></div>
        <div class="work" data-c="data ai"><span class="k">Compliance · SaaS</span><div><h3>Regulatory compliance software provider</h3><p class="s">Snowflake and dbt platform serving 200+ customers, with 50+ customer migrations.</p></div><span class="r">Staffing 20 → 5 with AI</span><span class="go"></span></div>
        <div class="work" data-c="apps reg"><span class="k">Public health</span><div><h3>Public health software provider</h3><p class="s">Outbreak management platform v2; biobank and sample-tracking 2.0 rewrite.</p></div><span class="r">Full audit trail</span><span class="go"></span></div>
        <div class="work" data-c="apps reg"><span class="k">Clinical genomics</span><div><h3>Clinical genomics laboratory</h3><p class="s">Lab execution platform front end and Oracle performance work.</p></div><span class="r">Prod in 7 wks · 1,500× query</span><span class="go"></span></div>
        <div class="work" data-c="apps reg"><span class="k">Retail · E-commerce</span><div><h3>Global prestige beauty company</h3><p class="s">E-commerce for 18 brands; XSS, SQL injection and PII-leak issues remediated.</p></div><span class="r">Checkout friction −80%</span><span class="go"></span></div>
        <div class="work" data-c="data reg"><span class="k">Internet services</span><div><h3>Web services and domain registration group</h3><p class="s">5-brand warehouse and a 1,000+ report BI portal for 1,500+ users; Do Not Call compliance.</p></div><span class="r">$500K+/yr saved</span><span class="go"></span></div>
      </div>
    </div>
  </section>
</section>
</Base>
